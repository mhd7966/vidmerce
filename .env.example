# ---- HTTP ----
APP_ENV=local
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- Logging ----
LOG_LEVEL=debug
LOG_FORMAT=text

# ---- Postgres ----
POSTGRES_DSN=postgres://vidmerce:vidmerce@127.0.0.1:5432/vidmerce?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_LIFETIME=30m

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- ClickHouse ----
CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_DB=vidmerce
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- Auth ----
JWT_SECRET=change-me-in-production-please-make-it-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# ---- Uniqueness (RedisBloom; requires Redis Stack in docker-compose) ----
BLOOM_ENABLED=true
BLOOM_ERROR_RATE=0.01
BLOOM_EMAIL_CAPACITY=1000000
BLOOM_PRODUCT_CAPACITY=500000

# ---- Feed ----
# pull = Postgres keyset pagination
# push = Redis ZSET fan-out (global feed cache)
FEED_MODE=pull
FEED_PAGE_DEFAULT=20
FEED_PAGE_MAX=50
FEED_PUSH_ZSET_CAP=1000

# ---- Views / spam ----
VIEW_UNIQUE_TTL=10m
VIEW_MIN_DURATION_SEC=5
VIEW_UNKNOWN_MIN_WATCH_MS=1000
VIEW_DURATION_CACHE_TTL=168h

# ---- Like ----
LIKE_LEAKY_BUCKET_CAPACITY=10
LIKE_LEAKY_BUCKET_LEAK_PER_MIN=5
# Shorter interval in local/demo so Grafana reconciler panels get data.
LIKE_RECONCILER_INTERVAL=30s
LIKE_RECONCILER_SAMPLE_SIZE=200

# ---- Metrics (Prometheus) ----
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_WORKER_PORT=9091
METRICS_REDIS_POLL_INTERVAL=15s

# ---- Stats / analytics ----
# How long a /stats response is cached. Bounds tail latency to the underlying
# ClickHouse + Postgres queries and caps backend QPS at (1 / cache_ttl) per
# (replica, video).
STATS_CACHE_TTL=30s
# Per-video distributed lock TTL. Must be > worst-case recompute latency.
STATS_LOCK_TTL=5s
# How long a lock-loser waits (re-polling the cache) before computing anyway.
STATS_LOCK_RETRY=75ms

# ---- Worker ----
WORKER_CONSUMER_GROUP=vidmerce-workers
WORKER_NAME=worker-1
WORKER_STREAM_PARTITIONS=8
WORKER_BATCH_SIZE=500
WORKER_BATCH_TIMEOUT=1s
